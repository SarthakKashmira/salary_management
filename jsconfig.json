{
  "compilerOptions": {
    "target": "ESNext",
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "apis/*": ["app/apis/*"],
      "assets/*": ["app/javascript/assets/*"],
      "common/*": ["app/javascript/common/*"],
      "components/*": ["app/javascript/components/*"],
      "constants/*": ["app/javascript/constants/*"],
      "translations/*": ["app/javascript/translations/*"],
      "utils/*": ["app/javascript/utils/*"]
    },
    "pretty": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "jsx": "preserve"
  },
  "exclude": ["**/node_modules", "**/.*/"],
  "include": [
    "./app/javascript/**/*.js",
    "./app/javascript/**/*.jsx",
    "./app/apis/**/*.js",
    "./**/*.d.ts"
  ]
}
